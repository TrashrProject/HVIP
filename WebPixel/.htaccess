RewriteEngine On
RewriteBase /

# Favicon racine : le navigateur demande souvent /favicon.ico même quand Nitro est dans /nitro-last/.
RewriteRule ^favicon\.ico$ nitro-last/favicon.ico [L,QSA,NC]

# Laisser passer les vrais fichiers/dossiers.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Fallback propre pour les assets Nitro/SWF manquants.
# Important : ce rewrite passe uniquement pour les fichiers inexistants,
# donc un vrai asset local garde toujours la priorité.
RewriteRule ^(.+\.(?:png|gif|jpe?g|webp|svg|ico|nitro|json|mp3|ogg|wav|ttf|otf|woff2?|eot))$ asset-resolver.php?u=/$1 [L,QSA,NC,B]

# URLs propres -> fichiers PHP correspondants
RewriteCond %{DOCUMENT_ROOT}/$1.php -f
RewriteRule ^(.+?)/?$ $1.php [L,QSA]

# Routes legacy
RewriteRule ^profile/(.+)$ profile.php?id=$1 [L,QSA]
RewriteRule ^corporation/(.+)$ corporation.php?id=$1 [L,QSA]
RewriteRule ^gang/(.+)$ gang.php?gang_id=$1 [L,QSA]
RewriteRule ^gangs/leaderboard/?$ gangs_leaderboard.php [L,QSA]
RewriteRule ^store/checkout/?$ store.php [L,QSA]
