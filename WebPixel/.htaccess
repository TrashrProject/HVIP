RewriteEngine On
RewriteBase /WebPixel/

# Keep real files/folders untouched
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Pretty URLs -> matching PHP files
RewriteCond %{DOCUMENT_ROOT}/WebPixel/$1.php -f
RewriteRule ^(.+?)/?$ $1.php [L,QSA]

# Specific legacy routes
RewriteRule ^profile/(.+)$ profile.php?id=$1 [L,QSA]
RewriteRule ^corporation/(.+)$ corporation.php?id=$1 [L,QSA]
RewriteRule ^gang/(.+)$ gang.php?gang_id=$1 [L,QSA]
RewriteRule ^gangs/leaderboard/?$ gangs_leaderboard.php [L,QSA]
RewriteRule ^store/checkout/?$ store.php [L,QSA]
