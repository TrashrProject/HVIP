<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <system.webServer>
        <rewrite>
            <rules>
                <rule name="Imported Rule 1">
                    <match url="^habbo-imaging/badge/none" ignoreCase="false" />
                    <action type="Rewrite" url="habbo-imaging/corp/none.gif" />
                </rule>
                <rule name="Imported Rule 2">
                    <match url="^habbo-imaging/badge/hospital" ignoreCase="false" />
                    <action type="Rewrite" url="habbo-imaging/corp/hospital.gif" />
                </rule>
                <rule name="Imported Rule 3">
                    <match url="^habbo-imaging/badge/police" ignoreCase="false" />
                    <action type="Rewrite" url="habbo-imaging/corp/police.gif" />
                </rule>
                <rule name="Imported Rule 4">
                    <match url="^habbo-imaging/badge/phone" ignoreCase="false" />
                    <action type="Rewrite" url="habbo-imaging/corp/phone.gif" />
                </rule>
                <rule name="Imported Rule 5">
                    <match url="^habbo-imaging/badge/gun" ignoreCase="false" />
                    <action type="Rewrite" url="habbo-imaging/corp/gun.gif" />
                </rule>
                <rule name="Imported Rule 6">
                    <match url="^habbo-imaging/badge/cafe" ignoreCase="false" />
                    <action type="Rewrite" url="habbo-imaging/corp/cafe.gif" />
                </rule>
                <rule name="Imported Rule 7">
                    <match url="^habbo-imaging/badge/clothing" ignoreCase="false" />
                    <action type="Rewrite" url="habbo-imaging/corp/clothing.gif" />
                </rule>
                <rule name="Imported Rule 8">
