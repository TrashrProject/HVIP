@'
# IDE
**/.vs/
**/.idea/
**/.vscode/

# Builds
**/bin/
**/obj/
**/Debug/
**/Release/

# Dépendances lourdes régénérables
**/node_modules/
**/packages/

# Cache / temporaire
**/cache/
**/temp/
**/tmp/
**/logs/
**/log/
*.log

# Windows / macOS
Thumbs.db
.DS_Store

# Secrets
.env
.env.*
!.env.example
secrets.*
*.key
'@ | Set-Content -Path ".gitignore" -Encoding UTF8